# Data — CMUdict, prevalence norms and derived indexes are large and
# regenerable. See docs/adr/0003 and docs/adr/0004. The committed pronunciation
# supplement (ADR-0009) is the one hand-authored input, so it is kept.
/data/*
!/data/supplement.dict
# The demotion list corrects the upstream word list's proper nouns and junk
# (ADR-0011, amended). Hand-authored, so it is kept for the same reason.
!/data/demotions.txt
*.csv
*.xlsx

